{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "quoteProps": "consistent",
    "embeddedLanguageFormatting": "auto",
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "tabWidth": 2,
                "useTabs": false
            }
        },
        {
            "files": "*.mcfunction",
            "options": {
                "printWidth": 120,
                "tabWidth": 4,
                "useTabs": false
            }
        },
        {
            "files": ["*.js", "*.mjs"],
            "options": {
                "semi": true,
                "singleQuote": false
            }
        }
    ]
}
